import json
import os
from fastapi import FastAPI, Security, HTTPException, status, Query
from fastapi.security.api_key import APIKeyHeader
from pydantic import BaseModel
from typing import Dict

app = FastAPI(title="Robot-to-PCC Bridge Engine")

# ==========================================
# 1. CONFIGURATION & PERMANENT STORAGE
# ==========================================
DB_FILE = "alerts_db.json"
API_KEY_NAME = "X-Bridge-API-Key"
api_key_header = APIKeyHeader(name=API_KEY_NAME, auto_error=False)

VALID_API_KEYS = {
    "bear_robotics_prod_secret_abc123",
    "keenon_robotics_test_xyz789"
}

# In-memory token storage for the PointClickCare Sandbox
PCC_STATE_STORE = {
    "access_token": None,
    "refresh_token": None
}

def initialize_database():
    if not os.path.exists(DB_FILE):
        with open(DB_FILE, "w") as f:
            json.dump([], f)
        print("💾 [DATABASE INITIALIZED] Created clean alerts_db.json file.")

initialize_database()

def read_active_alerts():
    with open(DB_FILE, "r") as f:
        return json.load(f)

def write_active_alert(event_id: str):
    alerts = read_active_alerts()
    if event_id not in alerts:
        alerts.append(event_id)
        with open(DB_FILE, "w") as f:
            json.dump(alerts, f, indent=4)

def remove_active_alert(event_id: str):
    alerts = read_active_alerts()
    if event_id in alerts:
        alerts.remove(event_id)
        with open(DB_FILE, "w") as f:
            json.dump(alerts, f, indent=4)
        return True
    return False

def verify_api_key(api_key: str = Security(api_key_header)):
    if api_key not in VALID_API_KEYS:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing X-Bridge-API-Key credentials."
        )
    return api_key

# ==========================================
# 2. DATA SCHEMAS & MOCK ROSTER
# ==========================================
class LocationPayload(BaseModel):
    mapId: str

class RobotAlertPayload(BaseModel):
    robotSn: str
    eventId: str
    state: str
    location: LocationPayload

MOCK_PCC_ROSTER: Dict[str, dict] = {
    "Floor_1_North": {"primary_nurse": {"name": "Sarah Jenkins, RN"}},
    "Floor_2_South": {"primary_nurse": {"name": "Michael Chang, LPN"}},
    "Memory_Care_A": {"primary_nurse": {"name": "Elena Rostova, RN"}}
}

# ==========================================
# 3. ROBOT TELEMETRY ENDPOINTS
# ==========================================
@app.post("/robot/alert")
async def receive_robot_alert(payload: RobotAlertPayload, api_key: str = Security(verify_api_key)):
    print(f"\n[🚨 AUTHORIZED SIGNAL] Webhook received from: {payload.robotSn}")
    try:
        if not payload.eventId or not payload.location:
            raise ValueError("Payload missing critical tracking fields.")

        current_active_alerts = read_active_alerts()
        if payload.eventId in current_active_alerts:
            print(f"🛑 [DUPLICATE BLOCKED] Event {payload.eventId} is already active on disk.")
            return {"status": "SUPPRESSED", "message": "Alert is already active."}

        if payload.state in ["ABORTED", "STUCK", "EMERGENCY"]:
            write_active_alert(payload.eventId)
            robot_location = payload.location.mapId

            if robot_location in MOCK_PCC_ROSTER:
                nurse_name = MOCK_PCC_ROSTER[robot_location]["primary_nurse"]["name"]
                return {
                    "status": "SUCCESS",
                    "action": "STAFF_DISPATCHED",
                    "dispatched_to": nurse_name,
                    "event_tracked_id": payload.eventId
                }
            else:
                return {"status": "UNMAPPED_LOCATION", "message": f"Zone '{robot_location}' unmapped."}

        return {"status": "SUCCESS", "action": "LOGGED"}
    except Exception as e:
        return {"status": "ERROR", "message": str(e)}

@app.post("/robot/resolve")
async def resolve_robot_alert(payload: RobotAlertPayload, api_key: str = Security(verify_api_key)):
    was_removed = remove_active_alert(payload.eventId)
    if was_removed:
        return {"status": "RESOLVED", "message": f"Event {payload.eventId} cleared."}
    return {"status": "NO_ACTION", "message": "Event not found."}

# ==========================================
# 4. POINTCLICKCARE SANDBOX ENDPOINT
# ==========================================
@app.get("/pcc/callback")
async def pcc_callback_handler(code: str = Query(..., description="The temporary auth code from PCC")):
    print(f"\n[🔑 PCC HANDSHAKE STEP 2] Intercepted Code from URL: {code}")

    # Simulating trading that single-use code for an actual access token
    PCC_STATE_STORE["access_token"] = f"pcc_live_bearer_token_{code[-4:]}_abc123"
    PCC_STATE_STORE["refresh_token"] = "pcc_refresh_token_vault_789"

    print(f"✅ [PCC HANDSHAKE COMPLETE] Access Token saved to memory state.")
    return {
        "status": "CONNECTION_SUCCESSFUL",
        "message": "Authenticated with PointClickCare Sandbox.",
        "token_preview": f"{PCC_STATE_STORE['access_token'][:18]}..."
    }

# ==========================================
# 5. DIAGNOSTIC & INSPECTION ENDPOINTS
# ==========================================
@app.get("/pcc/inspect-token")
async def inspect_stored_token():
    """Diagnostic route to check what is currently sitting in the server memory."""
    print(f"\n[🔍 MEMORY INSPECTION] Current Token State requested.")

    # Check if a token has actually been fetched yet
    if not PCC_STATE_STORE["access_token"]:
        return {
            "status": "EMPTY",
            "message": "No active token found in memory. You need to hit the callback route first."
        }

    return {
        "status": "ACTIVE_IN_RAM",
        "current_state": {
            "access_token": PCC_STATE_STORE["access_token"],
            "refresh_token": PCC_STATE_STORE["refresh_token"]
        }
    }